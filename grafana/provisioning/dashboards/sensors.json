{
  "uid": "sensors",
  "title": "Sensor Anomaly Detection",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Sensor Value",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sensor_value", "legendFormat": "{{sensor}}"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "Z-Score",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sensor_zscore", "legendFormat": "{{sensor}}"}],
      "fieldConfig": {"defaults": {
        "custom": {"thresholdsStyle": {"mode": "line+area"}},
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "red", "value": null}, {"color": "transparent", "value": -3}, {"color": "red", "value": 3}]}
      }, "overrides": []}
    },
    {
      "id": 3, "type": "state-timeline", "title": "Alert State",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sensor_alert_state", "legendFormat": "{{sensor}}"}],
      "fieldConfig": {"defaults": {
        "mappings": [{"type": "value", "options": {
          "0": {"text": "NORMAL", "color": "green"},
          "1": {"text": "ALERTING", "color": "red"}}}]
      }, "overrides": []}
    }
  ]
}
