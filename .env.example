# OPTIONAL. You do not need this file to run the project.
#
# To choose your own Grafana admin password, copy this file to ".env"
# (same folder) and change the value below. Without a .env file the login
# is admin / admin.
#
# Grafana only reads this the FIRST time it starts. After that, change the
# password inside Grafana, or reset everything with: docker compose down -v
GRAFANA_ADMIN_PASSWORD=change-me
